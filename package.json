{
  "name": "loja",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single && node scripts/package-single.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "build:web": "tsc --noEmit && vite build && cd dist && rm -f ../loja-web.zip && zip -q -r ../loja-web.zip . && echo \"✓ loja-web.zip criado\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "papaparse": "^5.5.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "snes.css": "^1.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^7.0.2",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  }
}
